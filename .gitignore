__pycache__/
*.pyc
.DS_Store
.venv*/
# Local working data (large, not evidence); never committed.
data/
# Run outputs. Large, and not evidence until a script can regenerate them.
output/

# A local API key file; never committed or printed.
.mapskey

# M-LSD weights and the ONNX it exports to: third-party, 5 MB, and this
# pipeline does not use the model. scripts/export_mlsd_onnx.py fetches them.
models/mlsd/*.pth
models/mlsd/*.onnx
models/mlsd/layers.py
models/mlsd/mbv2_mlsd*.py
# ALIKED (BSD-3) and its LightGlue matcher (Apache-2.0), ONNX, 52 MB: the files and
# sha1 that opencv_extra's testdata/dnn/download_models.py lists. scripts/fetch_aliked.sh fetches them.
models/aliked/

# 診斷圖:由 isolation/scripts/*.py 的 draw 步驟重建,不進版控
isolation/out/

# Video build outputs (regenerate with video/make_video.py); the API excerpt is a run output
video/out/
video/assets/*.json

# Outputs of isolation scripts (JSON is refused by the stage gate; regenerate from the scripts)
isolation/**/*.json
